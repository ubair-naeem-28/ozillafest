PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prism_event_and_tour
MONGO_URI=mongodb://127.0.0.1:27017/prism_event_and_tour
JWT_SECRET=replace_with_a_long_random_secret_for_your_environment
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
ALLOW_NO_DB_FALLBACK=true
IBAN_ACCOUNT=PK00-OZIL-1234567890
ADMIN_EMAILS=admin@ozillafestival.com
OTP_EXPOSE_FOR_DEV=true

# Gmail example:
# 1. Enable 2-Step Verification on Gmail.
# 2. Create a Gmail App Password.
# 3. Put that app password in SMTP_PASS, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Ozilla Festival <your_email@gmail.com>"
FRONTEND_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
