# ==============================================================================
# OZILLA FEST 2026 — Server Environment Variables (Render & Production)
# ==============================================================================

# Server Runtime Port
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourAtlasPassword@cluster0.abcde.mongodb.net/ozillafest?retryWrites=true&w=majority

# Security: JWT Token Secret (Use a strong 64+ char random string in production)
JWT_SECRET=ozilla_secure_jwt_secret_change_this_to_a_random_production_key_2026

# Allowed Frontend Origins (Comma separated - include GitHub Pages and Localhost)
CORS_ORIGIN=https://ubair-naeem-28.github.io,http://localhost:8080,http://localhost:5173

# Strict Database Enforcement (Set to false on live production server)
ALLOW_NO_DB_FALLBACK=false

# OTP Security (Set to false on production so OTP is delivered ONLY via real email)
OTP_EXPOSE_FOR_DEV=false

# Admin User Accounts (Comma separated emails granted access to /admin/tickets review dashboard)
ADMIN_EMAILS=ubair1100@gmail.com,obaer2102@gmail.com

# Email Notifications (Nodemailer SMTP with Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=obaer2102@gmail.com
SMTP_PASS=nqqg vovr pcsc halb
SMTP_FROM="Ozilla Fest 2026" <obaer2102@gmail.com>

# Google OAuth 2.0 GIS Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://ozillafest.onrender.com/api/auth/google/callback

# Live Frontend URL (Used for email back-links)
FRONTEND_URL=https://ubair-naeem-28.github.io/ozillafest

# Bank Account Details for Attendees (Direct IBAN Transfer)
IBAN_ACCOUNT=2205931265594411
PAYOUT_BANK_NAME=Mastercard Commercial Bank
PAYOUT_ACCOUNT_TITLE=TALAL NASEER

# JazzCash & Easypaisa Merchant Credentials (Optional / Live)
JAZZCASH_ACCOUNT=0300-1234567
JAZZCASH_TITLE=TALAL NASEER
EASYPAISA_ACCOUNT=0333-1234567
EASYPAISA_TITLE=TALAL NASEER
